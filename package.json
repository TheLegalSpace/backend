{
  "name": "legal-space-backend",
  "version": "0.1.0",
  "description": "The Legal Space - Two-sided platform connecting Nigerian users with verified lawyers and law firms",
  "main": "dist/app.js",
  "scripts": {
    "dev": "tsx watch src/app.ts",
    "build": "prisma generate --schema=src/database/prisma/schema.prisma && tsc",
    "start": "node dist/app.js",
    "migrate": "prisma migrate dev --schema=src/database/prisma/schema.prisma",
    "generate": "prisma generate --schema=src/database/prisma/schema.prisma",
    "seed": "tsx src/database/prisma/seed.ts",
    "studio": "prisma studio --schema=src/database/prisma/schema.prisma",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.658.0",
    "@aws-sdk/s3-request-presigner": "^3.658.0",
    "@fastify/cors": "^9.0.1",
    "@fastify/multipart": "^8.3.0",
    "@fastify/rate-limit": "^9.1.0",
    "@fastify/swagger": "^8.15.0",
    "@fastify/swagger-ui": "^4.0.1",
    "@google/genai": "^2.3.0",
    "@prisma/client": "^5.20.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "@supabase/supabase-js": "^2.45.4",
    "cloudinary": "^2.10.0",
    "dotenv": "^16.4.5",
    "fastify": "^4.28.1",
    "ioredis": "^5.4.1",
    "node-cron": "^3.0.3",
    "pdfkit": "^0.15.2",
    "pino": "^9.4.0",
    "pino-pretty": "^11.2.2",
    "slugify": "^1.6.6",
    "socket.io": "^4.7.5"
  },
  "devDependencies": {
    "@types/node": "^22.7.4",
    "@types/node-cron": "^3.0.11",
    "@types/pdfkit": "^0.17.6",
    "prisma": "^5.20.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vitest": "^2.1.1"
  }
}
