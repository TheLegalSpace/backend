generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Account {
  id              String    @id @default(uuid()) @db.Uuid
  authUserId      String    @unique @map("auth_user_id")
  email           String    @unique
  phone           String?
  role            String
  status          String    @default("active")
  fullName        String    @map("full_name")
  firstName       String?   @map("first_name")
  lastName        String?   @map("last_name")
  avatarUrl       String?   @map("avatar_url")
  coverUrl        String?   @map("cover_url")
  bio             String?
  locationCity    String?   @map("location_city")
  locationCountry String    @default("Nigeria") @map("location_country")
  isAnonymous     Boolean   @default(false) @map("is_anonymous")
  avgRating       Decimal   @default(0) @map("avg_rating") @db.Decimal(3, 2)
  reviewCount     Int       @default(0) @map("review_count")
  connectionCount Int       @default(0) @map("connection_count")
  followerCount   Int       @default(0) @map("follower_count")
  followingCount  Int       @default(0) @map("following_count")
  membershipTier      String    @default("community") @map("membership_tier")
  membershipExpiresAt DateTime? @map("membership_expires_at")
  lastActiveAt    DateTime  @default(now()) @map("last_active_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  lawyerProfile     LawyerProfile?
  firmProfile       FirmProfile?
  practiceAreaLinks AccountPracticeArea[]
  serviceOfferings  ServiceOffering[]
  posts             Post[]
  postReactions     PostReaction[]
  followsAsFollower Follow[]              @relation("Follower")
  followsAsFollowed Follow[]              @relation("Followed")
  outgoingRequests  Request[]             @relation("UserRequests")
  incomingLeads     Request[]             @relation("LawyerLeads")
  conversationsAsUser   Conversation[]    @relation("ConvUser")
  conversationsAsLawyer Conversation[]    @relation("ConvLawyer")
  conversationsClosed   Conversation[]    @relation("ConvClosedBy")
  messagesSent      Message[]
  reviewsGiven      Review[]              @relation("ReviewsGiven")
  reviewsReceived   Review[]              @relation("ReviewsReceived")
  notifications     Notification[]
  eventsCreated     Event[]
  verificationDocuments VerificationDocument[] @relation("AccountKyc")
  reviewedKycDocs       VerificationDocument[] @relation("AdminKycReview")
  firmsAsVerifyingPartner FirmProfile[]   @relation("VerifyingPartner")
  adminAuditLog     AdminAuditLog[]
  researchThreads   ResearchThread[]
  serviceRequests   ServiceRequest[]
  subscription      Subscription?
  payments          Payment[]
  invoices          Invoice[]
  paymentMethods    PaymentMethod[]

  @@index([role, status])
  @@index([role, status, locationCity])
  @@index([lastActiveAt(sort: Desc)])
  @@map("accounts")
}

model LawyerProfile {
  id                       String    @id @default(uuid()) @db.Uuid
  accountId                String    @unique @map("account_id") @db.Uuid
  scn                      String?   @unique
  callToBarYear            Int       @map("call_to_bar_year")
  nbaBranch                String?   @map("nba_branch")
  feeRangeMin              Int       @default(0) @map("fee_range_min")
  feeRangeMax              Int       @default(0) @map("fee_range_max")
  verificationStatus       String    @default("verified") @map("verification_status")
  verificationFlags        Json      @default("{}") @map("verification_flags")
  practicingCertExpiresAt  DateTime? @map("practicing_cert_expires_at")
  createdAt                DateTime  @default(now()) @map("created_at")
  updatedAt                DateTime  @updatedAt @map("updated_at")

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([verificationStatus])
  @@index([feeRangeMin, feeRangeMax])
  @@map("lawyer_profiles")
}

model FirmProfile {
  id                        String   @id @default(uuid()) @db.Uuid
  accountId                 String   @unique @map("account_id") @db.Uuid
  firmName                  String   @map("firm_name")
  rcNumber                  String?  @unique @map("rc_number")
  firmEstablishmentYear     Int      @map("firm_establishment_year")
  officeAddress             String?  @map("office_address")
  verifyingPartnerAccountId String?  @map("verifying_partner_account_id") @db.Uuid
  verifyingPartnerScn       String?  @map("verifying_partner_scn")
  feeRangeMin               Int      @default(0) @map("fee_range_min")
  feeRangeMax               Int      @default(0) @map("fee_range_max")
  verificationStatus        String   @default("verified") @map("verification_status")
  verificationFlags         Json     @default("{}") @map("verification_flags")
  createdAt                 DateTime @default(now()) @map("created_at")
  updatedAt                 DateTime @updatedAt @map("updated_at")

  account           Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  verifyingPartner  Account? @relation("VerifyingPartner", fields: [verifyingPartnerAccountId], references: [id])

  @@index([verificationStatus])
  @@index([feeRangeMin, feeRangeMax])
  @@map("firm_profiles")
}

model PracticeArea {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  slug      String   @unique
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  accountLinks     AccountPracticeArea[]
  serviceOfferings ServiceOffering[]

  @@map("practice_areas")
}

model ServiceOffering {
  id             String   @id @default(uuid()) @db.Uuid
  accountId      String   @map("account_id") @db.Uuid
  practiceAreaId String   @map("practice_area_id") @db.Uuid
  name           String
  price          Int
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  account      Account      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  practiceArea PracticeArea @relation(fields: [practiceAreaId], references: [id], onDelete: Cascade)

  @@index([accountId, practiceAreaId])
  @@map("service_offerings")
}

model AccountPracticeArea {
  id             String   @id @default(uuid()) @db.Uuid
  accountId      String   @map("account_id") @db.Uuid
  practiceAreaId String   @map("practice_area_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")

  account      Account      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  practiceArea PracticeArea @relation(fields: [practiceAreaId], references: [id], onDelete: Cascade)

  @@unique([accountId, practiceAreaId])
  @@index([practiceAreaId])
  @@map("account_practice_areas")
}

model Post {
  id              String    @id @default(uuid()) @db.Uuid
  authorAccountId String    @map("author_account_id") @db.Uuid
  title           String?
  body            String
  pdfUrl          String?   @map("pdf_url")
  pdfName         String?   @map("pdf_name")
  pdfSizeBytes    Int?      @map("pdf_size_bytes")
  likeCount       Int       @default(0) @map("like_count")
  dislikeCount    Int       @default(0) @map("dislike_count")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  author    Account        @relation(fields: [authorAccountId], references: [id], onDelete: Cascade)
  reactions PostReaction[]

  @@index([authorAccountId])
  @@index([createdAt(sort: Desc)])
  @@map("posts")
}

model PostReaction {
  id        String   @id @default(uuid()) @db.Uuid
  postId    String   @map("post_id") @db.Uuid
  accountId String   @map("account_id") @db.Uuid
  type      String
  createdAt DateTime @default(now()) @map("created_at")

  post    Post    @relation(fields: [postId], references: [id], onDelete: Cascade)
  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([postId, accountId])
  @@map("post_reactions")
}

model Follow {
  id                 String   @id @default(uuid()) @db.Uuid
  followerAccountId  String   @map("follower_account_id") @db.Uuid
  followedAccountId  String   @map("followed_account_id") @db.Uuid
  createdAt          DateTime @default(now()) @map("created_at")

  follower Account @relation("Follower", fields: [followerAccountId], references: [id], onDelete: Cascade)
  followed Account @relation("Followed", fields: [followedAccountId], references: [id], onDelete: Cascade)

  @@unique([followerAccountId, followedAccountId])
  @@map("follows")
}

model Request {
  id              String    @id @default(uuid()) @db.Uuid
  userAccountId   String    @map("user_account_id") @db.Uuid
  lawyerAccountId String    @map("lawyer_account_id") @db.Uuid
  intakePayload   Json      @map("intake_payload")
  relevanceScore  Int       @default(0) @map("relevance_score")
  status          String    @default("pending")
  conversationId  String?   @unique @map("conversation_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at")
  respondedAt     DateTime? @map("responded_at")
  expiresAt       DateTime  @map("expires_at")

  userAccount   Account       @relation("UserRequests", fields: [userAccountId], references: [id], onDelete: Cascade)
  lawyerAccount Account       @relation("LawyerLeads", fields: [lawyerAccountId], references: [id], onDelete: Cascade)
  conversation  Conversation? @relation(fields: [conversationId], references: [id])

  @@index([userAccountId, status, createdAt(sort: Desc)])
  @@index([lawyerAccountId, status, createdAt(sort: Desc)])
  @@index([expiresAt])
  @@map("requests")
}

model Conversation {
  id                  String    @id @default(uuid()) @db.Uuid
  userAccountId       String    @map("user_account_id") @db.Uuid
  lawyerAccountId     String    @map("lawyer_account_id") @db.Uuid
  requestId           String    @unique @map("request_id") @db.Uuid
  status              String    @default("active")
  lastMessageAt       DateTime? @map("last_message_at")
  lastMessagePreview  String?   @map("last_message_preview")
  closedAt            DateTime? @map("closed_at")
  closedByAccountId   String?   @map("closed_by_account_id") @db.Uuid
  createdAt           DateTime  @default(now()) @map("created_at")

  userAccount   Account  @relation("ConvUser", fields: [userAccountId], references: [id], onDelete: Cascade)
  lawyerAccount Account  @relation("ConvLawyer", fields: [lawyerAccountId], references: [id], onDelete: Cascade)
  closedBy      Account? @relation("ConvClosedBy", fields: [closedByAccountId], references: [id])
  request       Request?
  messages      Message[]
  reviews       Review[]
  connections   Connection[]

  @@index([userAccountId, lastMessageAt(sort: Desc)])
  @@index([lawyerAccountId, lastMessageAt(sort: Desc)])
  @@map("conversations")
}

model Message {
  id              String    @id @default(uuid()) @db.Uuid
  conversationId  String    @map("conversation_id") @db.Uuid
  senderAccountId String    @map("sender_account_id") @db.Uuid
  body            String
  attachments     Json?
  readAt          DateTime? @map("read_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       Account      @relation(fields: [senderAccountId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt(sort: Desc)])
  @@map("messages")
}

model Connection {
  id                  String   @id @default(uuid()) @db.Uuid
  accountAId          String   @map("account_a_id") @db.Uuid
  accountBId          String   @map("account_b_id") @db.Uuid
  firstConversationId String   @map("first_conversation_id") @db.Uuid
  createdAt           DateTime @default(now()) @map("created_at")

  firstConversation Conversation @relation(fields: [firstConversationId], references: [id])

  @@unique([accountAId, accountBId])
  @@index([accountAId])
  @@index([accountBId])
  @@map("connections")
}

model Review {
  id                 String    @id @default(uuid()) @db.Uuid
  reviewerAccountId  String    @map("reviewer_account_id") @db.Uuid
  reviewedAccountId  String    @map("reviewed_account_id") @db.Uuid
  conversationId     String    @map("conversation_id") @db.Uuid
  rating             Int
  body               String?
  createdAt          DateTime  @default(now()) @map("created_at")
  deletedAt          DateTime? @map("deleted_at")

  reviewer     Account      @relation("ReviewsGiven", fields: [reviewerAccountId], references: [id], onDelete: Cascade)
  reviewed     Account      @relation("ReviewsReceived", fields: [reviewedAccountId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([reviewerAccountId, reviewedAccountId, conversationId])
  @@index([reviewedAccountId, createdAt(sort: Desc)])
  @@index([conversationId])
  @@map("reviews")
}

model Notification {
  id                  String    @id @default(uuid()) @db.Uuid
  recipientAccountId  String    @map("recipient_account_id") @db.Uuid
  type                String
  payload             Json
  readAt              DateTime? @map("read_at")
  emailedAt           DateTime? @map("emailed_at")
  createdAt           DateTime  @default(now()) @map("created_at")

  recipient Account @relation(fields: [recipientAccountId], references: [id], onDelete: Cascade)

  @@index([recipientAccountId, createdAt(sort: Desc)])
  @@index([recipientAccountId, readAt])
  @@map("notifications")
}

model Event {
  id                String    @id @default(uuid()) @db.Uuid
  title             String
  description       String?
  coverUrl          String?   @map("cover_url")
  location          String?
  startAt           DateTime  @map("start_at")
  endAt             DateTime? @map("end_at")
  registrationUrl   String?   @map("registration_url")
  status            String    @default("draft")
  createdByAdminId  String?   @map("created_by_admin_id") @db.Uuid
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  createdByAdmin Account?        @relation(fields: [createdByAdminId], references: [id])
  serviceRequest ServiceRequest?

  @@index([status, startAt])
  @@map("events")
}

model ServiceRequest {
  id            String    @id @default(uuid()) @db.Uuid
  accountId     String    @map("account_id") @db.Uuid
  type          String // website | appointment | productivity | consulting | event_promotion
  status        String    @default("pending") // pending | contacted | closed | active | completed
  contactName   String?   @map("contact_name")
  contactEmail  String    @map("contact_email")
  contactPhone  String?   @map("contact_phone")
  firmName      String?   @map("firm_name")
  payload       Json
  amount        Int? // total in kobo (promotion only)
  pricing       Json? // { days, dailyRateKobo, socialAddonKobo, totalKobo }
  paymentStatus String    @default("not_required") @map("payment_status") // not_required | pending | paid
  eventId       String?   @unique @map("event_id") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  event   Event?  @relation(fields: [eventId], references: [id])

  @@index([accountId, createdAt(sort: Desc)])
  @@index([type, status, createdAt(sort: Desc)])
  @@map("service_requests")
}

model VerificationDocument {
  id                 String    @id @default(uuid()) @db.Uuid
  accountId          String    @map("account_id") @db.Uuid
  docType            String    @map("doc_type")
  s3Key              String    @map("s3_key")
  ocrExtracted       Json?     @map("ocr_extracted")
  status             String    @default("pending")
  reviewedByAdminId  String?   @map("reviewed_by_admin_id") @db.Uuid
  reviewedAt         DateTime? @map("reviewed_at")
  rejectionReason    String?   @map("rejection_reason")
  createdAt          DateTime  @default(now()) @map("created_at")

  account         Account  @relation("AccountKyc", fields: [accountId], references: [id], onDelete: Cascade)
  reviewedByAdmin Account? @relation("AdminKycReview", fields: [reviewedByAdminId], references: [id])

  @@index([accountId, docType])
  @@index([status])
  @@map("verification_documents")
}

model AdminAuditLog {
  id              String   @id @default(uuid()) @db.Uuid
  adminAccountId  String   @map("admin_account_id") @db.Uuid
  action          String
  targetType      String?  @map("target_type")
  targetId        String?  @map("target_id") @db.Uuid
  reason          String?
  metadata        Json?
  createdAt       DateTime @default(now()) @map("created_at")

  admin Account @relation(fields: [adminAccountId], references: [id])

  @@index([adminAccountId, createdAt(sort: Desc)])
  @@index([targetType, targetId])
  @@map("admin_audit_log")
}

model AccountSettings {
  id                          String   @id @default(uuid()) @db.Uuid
  accountId                   String   @unique @map("account_id") @db.Uuid
  notificationEmailEnabled    Boolean  @default(true) @map("notification_email_enabled")
  language                    String   @default("en")
  theme                       String   @default("light")
  createdAt                   DateTime @default(now()) @map("created_at")
  updatedAt                   DateTime @updatedAt @map("updated_at")

  @@map("account_settings")
}

model ResearchThread {
  id        String    @id @default(uuid()) @db.Uuid
  accountId String    @map("account_id") @db.Uuid
  title     String    @default("New research")
  pinned    Boolean   @default(false)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  account  Account           @relation(fields: [accountId], references: [id], onDelete: Cascade)
  messages ResearchMessage[]

  @@index([accountId, pinned, updatedAt(sort: Desc)])
  @@map("research_threads")
}

model ResearchMessage {
  id          String   @id @default(uuid()) @db.Uuid
  threadId    String   @map("thread_id") @db.Uuid
  role        String // "user" | "assistant"
  content     String
  attachments Json? // [{ kind:"pdf", url, filename, sizeBytes }]
  sources     Json? // [{ title, url }] from grounding metadata
  confident   Boolean? // assistant only; false when it returned the refusal
  createdAt   DateTime @default(now()) @map("created_at")

  thread ResearchThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId, createdAt])
  @@map("research_messages")
}

model Plan {
  id               String   @id @default(uuid()) @db.Uuid
  code             String   @unique // community | professional_lawyer | professional_firm
  name             String
  tier             String // community | professional
  forRole          String?  @map("for_role") // LAWYER | FIRM | null (community applies to all)
  priceKobo        Int      @default(0) @map("price_kobo")
  intervalMonths   Int      @default(6) @map("interval_months")
  paystackPlanCode String?  @map("paystack_plan_code") // populated after the Plan is created on Paystack
  features         Json     @default("[]") // string[] for the comparison UI
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  subscriptions Subscription[]

  @@map("plans")
}

model Subscription {
  id                       String    @id @default(uuid()) @db.Uuid
  accountId                String    @unique @map("account_id") @db.Uuid
  planId                   String    @map("plan_id") @db.Uuid
  status                   String    @default("active") // active | non_renewing | past_due | cancelled | expired
  autoRenew                Boolean   @default(true) @map("auto_renew")
  paystackCustomerCode     String?   @map("paystack_customer_code")
  paystackSubscriptionCode String?   @map("paystack_subscription_code")
  paystackEmailToken       String?   @map("paystack_email_token")
  currentPeriodStart       DateTime? @map("current_period_start")
  currentPeriodEnd         DateTime? @map("current_period_end")
  createdAt                DateTime  @default(now()) @map("created_at")
  updatedAt                DateTime  @updatedAt @map("updated_at")

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  plan    Plan    @relation(fields: [planId], references: [id])

  @@index([status, currentPeriodEnd])
  @@map("subscriptions")
}

model Payment {
  id                String    @id @default(uuid()) @db.Uuid
  accountId         String    @map("account_id") @db.Uuid
  subscriptionId    String?   @map("subscription_id") @db.Uuid
  paystackReference String    @unique @map("paystack_reference")
  amountKobo        Int       @map("amount_kobo")
  currency          String    @default("NGN")
  status            String    @default("pending") // pending | success | failed
  channel           String?
  cardLast4         String?   @map("card_last4")
  cardBrand         String?   @map("card_brand")
  paidAt            DateTime? @map("paid_at")
  gatewayResponse   Json?     @map("gateway_response")
  createdAt         DateTime  @default(now()) @map("created_at")

  account Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  invoice Invoice?

  @@index([accountId, createdAt(sort: Desc)])
  @@map("payments")
}

model Invoice {
  id             String    @id @default(uuid()) @db.Uuid
  accountId      String    @map("account_id") @db.Uuid
  subscriptionId String?   @map("subscription_id") @db.Uuid
  paymentId      String?   @unique @map("payment_id") @db.Uuid
  invoiceNumber  String    @unique @map("invoice_number")
  planName       String    @map("plan_name")
  amountKobo     Int       @map("amount_kobo")
  status         String    @default("paid") // paid | pending | failed
  issuedAt       DateTime  @default(now()) @map("issued_at")
  periodStart    DateTime? @map("period_start")
  periodEnd      DateTime? @map("period_end")
  pdfUrl         String?   @map("pdf_url")
  createdAt      DateTime  @default(now()) @map("created_at")

  account Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  payment Payment? @relation(fields: [paymentId], references: [id])

  @@index([accountId, issuedAt(sort: Desc)])
  @@map("invoices")
}

model PaymentMethod {
  id                        String   @id @default(uuid()) @db.Uuid
  accountId                 String   @map("account_id") @db.Uuid
  paystackAuthorizationCode String   @map("paystack_authorization_code")
  cardLast4                 String?  @map("card_last4")
  cardBrand                 String?  @map("card_brand")
  expMonth                  String?  @map("exp_month")
  expYear                   String?  @map("exp_year")
  bank                      String?
  isDefault                 Boolean  @default(true) @map("is_default")
  createdAt                 DateTime @default(now()) @map("created_at")
  updatedAt                 DateTime @updatedAt @map("updated_at")

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, paystackAuthorizationCode])
  @@index([accountId])
  @@map("payment_methods")
}
